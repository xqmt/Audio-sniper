local snowflakes = {}
local maxSnowflakes = 70 -- ปรับจำนวนหิมะเป็น 60

local function createSnowflake()
    local flake = Instance.new("Frame")
    local size = math.random(3, 7)
    flake.Size = UDim2.new(0, size, 0, size)
    flake.Position = UDim2.new(math.random(), 0, -0.05, 0)
    flake.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    
    local baseTransparency = math.random(10, 30) / 60
    flake.BackgroundTransparency = baseTransparency
    flake.BorderSizePixel = 0
    flake.ZIndex = 0
    flake.Parent = snowContainer

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = flake

    local flakeData = {
        Frame = flake,
        BaseTransparency = baseTransparency,
        SpeedY = math.random(8, 20) / 1000,
        SpeedX = (math.random(-5, 5) / 1000),
        SwayFreq = math.random(1, 3),
        SwayAmp = math.random(5, 15) / 10000,
        Seed = math.random() * 100
    }
    table.insert(snowflakes, flakeData)
end

for i = 1, maxSnowflakes do
    createSnowflake()
    snowflakes[#snowflakes].Frame.Position = UDim2.new(math.random(), 0, math.random(), 0)
end

local snowConnection
snowConnection = RunService.RenderStepped:Connect(function(dt)
    local fadeFactor = 1 - (bgDim.BackgroundTransparency / 1)
    local time = os.clock()
    
    for _, flake in ipairs(snowflakes) do
        flake.Frame.BackgroundTransparency = 1 - ((1 - flake.BaseTransparency) * fadeFactor)

        local currentX = flake.Frame.Position.X.Scale
        local currentY = flake.Frame.Position.Y.Scale

        -- ปรับความเร็วและสเวย์เป็น 0.25
        local newY = currentY + (flake.SpeedY * dt * 60 * 0.25)
        local sway = math.sin(time * flake.SwayFreq + flake.Seed) * (flake.SwayAmp * 0.25)
        local newX = currentX + (flake.SpeedX * 0.25) + sway

        if newY > 1.05 then
            newY = -0.05
            newX = math.random()
        end

        if newX < -0.05 then newX = 1.05
        elseif newX > 1.05 then newX = -0.05 end

        flake.Frame.Position = UDim2.new(newX, 0, newY, 0)
    end
end)
