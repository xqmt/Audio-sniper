            local percentage = posX / sliderBg.AbsoluteSize.X
            if activePreviewSound.TimeLength > 0 then
                activePreviewSound.TimePosition = percentage * activePreviewSound.TimeLength
                TweenService:Create(sliderFill, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Size = UDim2.new(percentage, 0, 1, 0)
                }):Play()
            end
        end

        sliderBg.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isDragging = true
                updateSeek(input)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isDragging = false
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateSeek(input)
            end
        end)

        task.spawn(function()
            while card.Parent do
                task.wait(0.1)
                if activePreviewSound and activePreviewBtn == previewBtn and not isDragging then
                    local length = activePreviewSound.TimeLength
                    local pos = activePreviewSound.TimePosition
                    if length > 0 then
                        local progress = math.clamp(pos / length, 0, 1)
                        TweenService:Create(sliderFill, TweenInfo.new(0.1, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {
                            Size = UDim2.new(progress, 0, 1, 0)
                        }):Play()
                        durationLabel.Text = formatTime(pos) .. " / " .. formatTime(length)
                    end
                end
            end
        end)

        local copyBtn = Instance.new("TextButton")
        copyBtn.Parent = topFrame
        copyBtn.Position = UDim2.new(1, -70, 0.5, -13)
        copyBtn.Size = UDim2.new(0, 60, 0, 26)
        copyBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        copyBtn.Font = Enum.Font.GothamMedium
        copyBtn.Text = "Copy"
        copyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        copyBtn.TextSize = 10
        copyBtn.AutoButtonColor = false

        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 6)
        btnCorner.Parent = copyBtn

        local copyStroke = Instance.new("UIStroke")
        copyStroke.Color = Color3.fromRGB(14, 14, 14)
        copyStroke.Thickness = 1
        copyStroke.Parent = copyBtn

        copyBtn.MouseButton1Click:Connect(function()
            if not confirmState[copyBtn] then
                confirmState[copyBtn] = true
                copyBtn.Text = "Sure?"
                copyBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)

                task.wait(2)
                if confirmState[copyBtn] then
                    confirmState[copyBtn] = nil
                    copyBtn.Text = "Copy"
                    copyBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                end
            else
                confirmState[copyBtn] = nil
                setclipboard(soundId)
                copyBtn.Text = "Copied"
                copyBtn.BackgroundColor3 = Color3.fromRGB(50, 90, 60)

                task.wait(1.5)
                copyBtn.Text = "Copy"
                copyBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            end
        end)

        local filterText = string.lower(searchBox.Text)
        if filterText ~= "" and not string.find(string.lower(playerName), filterText) and not string.find(string.lower(username), filterText) then
            card.Visible = false
        end

        cardData = { Card = card, PlayerName = string.lower(playerName), Username = string.lower(username) }
        activeSongs[key] = cardData
        pendingCheck[key] = nil

        if scroll.CanvasPosition.Y > 20 then
            showNotification(soundId)
        end
    end)
end

searchBox:GetPropertyChangedSignal("Text"):Connect(function()
    local searchText = string.lower(searchBox.Text)
    for _, data in pairs(activeSongs) do
        if data.Card then
            if searchText == "" or string.find(data.PlayerName, searchText) or string.find(data.Username, searchText) then
                data.Card.Visible = true
            else
                data.Card.Visible = false
            end
        end
    end
end)

local function checkAndAddSound(sound)
    if not sound:IsA("Sound") then return end
    
    local function evaluate()
        if sound.IsPlaying then
            local soundID = sound.SoundId:match("%d+")
            if soundID and not IGNORED_IDS[soundID] then
                local player = getPlayerFromSound(sound)
                local key = (player and player.UserId or "unknown") .. "_" .. soundID

                if not activeSongs[key] and not pendingCheck[key] then
                    createOrUpdateSongCard(player, soundID)
                end
            end
        end
    end

    evaluate()

    sound:GetPropertyChangedSignal("IsPlaying"):Connect(evaluate)
    sound:GetPropertyChangedSignal("SoundId"):Connect(evaluate)
end

for _, object in pairs(workspace:GetDescendants()) do
    checkAndAddSound(object)
end

workspace.DescendantAdded:Connect(checkAndAddSound)
