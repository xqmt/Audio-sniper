            ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 210, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(80, 100, 255))
        })
        previewGrad.Parent = previewStroke

        previewBtn.MouseEnter:Connect(function()
            TweenService:Create(previewStroke, TweenInfo.new(0.2), {Thickness = 2.2, Transparency = 0}):Play()
