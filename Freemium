local function getAssetInfo(soundId)
    if cache[soundId] then return cache[soundId] end
    local success, result = pcall(function()
        return MarketplaceService:GetProductInfo(tonumber(soundId), Enum.InfoType.Asset)
    end)
    if success and result then
        local createdYear = "Unknown"
        if result.Created then
            createdYear = string.sub(result.Created, 1, 4)
        end

        local info = {
            Name = result.Name or "Unknown Title",
            Creator = (result.Creator and result.Creator.Name) or "Unknown Creator",
            CreatorTargetId = result.Creator and result.Creator.CreatorTargetId or 0,
            CreatedYear = createdYear
        }
        cache[soundId] = info
        return info
    end
    return { Name = "Unknown Audio", Creator = "Unknown Creator", CreatorTargetId = 0, CreatedYear = "Unknown" }
end

local function isRobloxAsset(soundId)
    local info = getAssetInfo(soundId)
    local creatorName = string.lower(info.Creator or "")
    if creatorName == "roblox" or info.CreatorTargetId == 1 then
        return true
    end
    return false
end

local function isSoundPlayable(soundId)
    if playableCache[soundId] ~= nil then 
        return playableCache[soundId] 
    end

    local tempSound = Instance.new("Sound")
    tempSound.SoundId = "rbxassetid://" .. soundId
    tempSound.Volume = 0
    tempSound.Parent = SoundService

    local isLoaded = false
    local success = pcall(function()
        ContentProvider:PreloadAsync({tempSound})
    end)

    if success and tempSound.TimeLength > 0 then
        isLoaded = true
    else
        isLoaded = false
    end

    tempSound:Destroy()
    playableCache[soundId] = isLoaded
    return isLoaded
end

local function formatTime(seconds)
    if not seconds or seconds ~= seconds then return "0:00" end
    local mins = math.floor(seconds / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%d:%02d", mins, secs)
end

local function makeSmoothDraggable(frame)
    local dragging = false
    local dragInput, dragStart, startPos

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            local targetPos = UDim2.new(
                startPos.X.Scale, 
                startPos.X.Offset + delta.X, 
                startPos.Y.Scale, 
                startPos.Y.Offset + delta.Y
            )
            TweenService:Create(frame, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Position = targetPos
            }):Play()
        end
    end)
end

