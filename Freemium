                activePreviewSound = nil
            end
            if activePreviewBtn then
                activePreviewBtn.Text = "Preview"
                activePreviewBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                activePreviewBtn.TextColor3 = Color3.fromRGB(200, 220, 255)
                
                local currentStroke = activePreviewBtn:FindFirstChildOfClass("UIStroke")
                if currentStroke then
                    local grad = currentStroke:FindFirstChildOfClass("UIGradient")
                    if grad then
                        grad.Color = ColorSequence.new({
                            ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 210, 255)),
                            ColorSequenceKeypoint.new(1, Color3.fromRGB(80, 100, 255))
